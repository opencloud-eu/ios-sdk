    "A modified, unsynchronized version of \"%@\" is present on your device. Downloading the file from the server will overwrite it and modifications be lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf Ihrem Gerät befindet sich eine modifizierte, nicht synchronisierte Version von „%@“. Durch das Herunterladen der Datei vom Server wird diese überschrieben, und Ihre Änderungen gehen verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A modified, unsynchronized version of \"%@\" is present on your device. Downloading the file from the server will overwrite it and modifications be lost."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een aangepaste, niet-gesynchroniseerde versie van \"%@\" is aanwezig op uw apparaat. Als u het bestand van de server downloadt, wordt het overschreven en gaan wijzigingen verloren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmodyfikowana, niezsynchronizowana wersja \"%@\" znajduje się na Twoim urządzeniu. Pobranie pliku z serwera nadpisze ją i zmiany zostaną utracone."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ändrad, osynkroniserad version av ”%@” finns på enheten. Om du laddar ner filen från servern skrivs den över och ändringarna går förlorade."
          }
        }
      }
    },
