        }
      }
    },
    "\"%@\" was modified locally before the download completed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" wurde lokal geändert, bevor der Download beendet wurde."
