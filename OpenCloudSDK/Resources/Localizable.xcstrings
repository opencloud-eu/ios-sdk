    "{{itemName}} is currently processed on the server and can't be downloaded until it finishes processing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{itemName}} wird gerade auf dem Server verarbeitet und kann nicht heruntergeladen werden bis die Verarbeitung abgeschlossen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{itemName}} is currently processed on the server and can't be downloaded until it finishes processing."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{itemName}} wordt momenteel verwerkt op de server en kan pas worden gedownload als de verwerking is voltooid."
