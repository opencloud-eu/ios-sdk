    "An error occured trying to validate the certificate for %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Versuch, das Zertifikat für %@ zu überprüfen, ist ein Fehler aufgetreten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An error occured trying to validate the certificate for %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is een fout opgetreden bij het valideren van het certificaat voor %@."
          }
        }
      }
    },
    "An exception occured attempting to perform an action (\"%@\"). The action has been removed from the sync queue and may not have completed. If logging is enabled, the exception has been logged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Versuch, eine Aktion („%@“) auszuführen, ist eine Ausnahme aufgetreten. Die Aktion wurde aus der Synchronisierungswarteschlange entfernt und wurde möglicherweise nicht abgeschlossen. Falls die Protokollierung aktiviert ist, wurde die Ausnahme protokolliert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An exception occured attempting to perform an action (\"%@\"). The action has been removed from the sync queue and may not have completed. If logging is enabled, the exception has been logged."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er deed zich een uitzondering voor bij een poging een actie uit te voeren (\"%@\"). De actie is verwijderd uit de synchronisatiewachtrij en is mogelijk niet voltooid. Als het logboek is ingeschakeld, is de uitzondering geregistreerd."
          }
        }
      }
    },
