    },
    "\"%@\" metadata for %@ couldn't be updated" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" Metadaten für %2$@ konnten nicht aktualisiert werden"
